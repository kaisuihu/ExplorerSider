<Window x:Class="ExplorerSider.UI.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExplorerSider 书签栏"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" DragLeave="Window_DragLeave">
    <Border x:Name="RootBorder" CornerRadius="10" Background="#F7F7FA"
            BorderBrush="#DCDCE4" BorderThickness="1" Padding="7,4">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="HandleIcon" Width="16" Height="16" Margin="3,4,5,4"
                   Cursor="SizeAll" ToolTip="按住拖动定位 · 右键本区域设置停靠位置"
                   MouseLeftButtonDown="Handle_MouseLeftButtonDown" MouseEnter="Handle_MouseEnter" MouseLeave="Handle_MouseLeave"/>
            <ItemsControl x:Name="BarItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button x:Name="AddButton" Content="＋" FontSize="13" Padding="6,2" Margin="4,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="新建书签" Click="AddButton_Click"/>
        </StackPanel>
    </Border>
</Window>
