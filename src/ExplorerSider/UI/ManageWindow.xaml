<Window x:Class="ExplorerSider.UI.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExplorerSider 书签管理" Width="720" Height="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop"
        xmlns:ui="clr-namespace:ExplorerSider.UI">
    <Window.Resources>
        <ui:IconToImageConverter x:Key="IconConv"/>
        <ui:PathDisplayConverter x:Key="PathConv"/>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="导入书签（Netscape HTML / Clover 备份）…" Click="Import_Click"/>
                <MenuItem Header="导出书签（Netscape HTML）…" Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="打开数据目录" Click="OpenDataDir_Click"/>
                <MenuItem Header="开机自启" IsCheckable="True" x:Name="AutoStartMenu" Click="AutoStart_Click"/>
                <Separator/>
                <MenuItem Header="退出程序" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="操作">
                <MenuItem Header="新建书签" InputGestureText="Ins" Click="NewBookmark_Click"/>
                <MenuItem Header="新建文件夹" Click="NewFolder_Click"/>
                <MenuItem Header="编辑…" InputGestureText="F2" Click="Edit_Click"/>
                <MenuItem Header="删除" InputGestureText="Del" Click="Delete_Click"/>
                <Separator/>
                <MenuItem Header="检查失效路径" Click="CheckPaths_Click"/>
                <MenuItem Header="刷新全部图标" Click="RefreshIcons_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <Button Content="新建书签" Click="NewBookmark_Click"/>
                <Button Content="新建文件夹" Click="NewFolder_Click"/>
                <Button Content="编辑" Click="Edit_Click"/>
                <Button Content="删除" Click="Delete_Click"/>
                <Separator/>
                <Button Content="↑上移" Click="Up_Click"/>
                <Button Content="↓下移" Click="Down_Click"/>
                <Separator/>
                <Button Content="检查失效路径" Click="CheckPaths_Click"/>
                <Button Content="刷新全部图标" Click="RefreshIcons_Click"/>
            </ToolBar>
        </ToolBarTray>

        <Grid>
            <TreeView x:Name="Tree" Margin="6"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      KeyDown="Tree_KeyDown"
                      MouseDoubleClick="Tree_MouseDoubleClick"
                      AllowDrop="True"
                      DragOver="Tree_DragOver" Drop="Tree_Drop">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PathInvalid}" Value="True">
                                <Setter Property="Foreground" Value="#D32F2F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <Setter Property="Background" Value="#CCE8FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon, Converter={StaticResource IconConv}}" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock x:Name="NodeName" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NodePath" Text="{Binding Path, Converter={StaticResource PathConv}}"
                                       Foreground="Gray" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                <Setter TargetName="NodePath" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter TargetName="NodePath" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock x:Name="StatusText" Text="提示：从资源管理器拖入文件/文件夹可快速创建书签；拖动节点可调整顺序与层级"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10" Foreground="Gray" FontSize="11"
                       IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
